<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_320">
    <xacro:arg name="robot_name" default="mycobot_320"/>
    <xacro:arg name="add_world" default="true"/>
    <xacro:arg name="base_link" default="base_link"/>
    <xacro:arg name="base_type" default="g_shape"/>
    <xacro:arg name="flange_link" default="link6_flange"/>
    <xacro:arg name="gripper_type" default="adaptive_gripper"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="use_camera" default="false"/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="use_gripper" default="true"/>

    <xacro:if value="$(arg add_world)">
      <link name="world"/>
      <joint name="$(arg prefix)virtual_joint" type="fixed">
          <parent link="world"/>
          <child link="$(arg prefix)$(arg base_link)"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <xacro:property name="current_base" value="$(arg base_type)"/>
    <xacro:if value="${current_base == 'g_shape'}">
        <xacro:include filename="$(find mycobot_description)/urdf/mech/g_shape_base_v2_0.urdf.xacro"/>
        <xacro:g_shape_base
            base_link="$(arg base_link)"
            prefix="$(arg prefix)"/>
    </xacro:if>

    <xacro:include filename="$(find mycobot_description)/urdf/mech/mycobot_320_arm.urdf.xacro"/>
    <xacro:mycobot_320_arm
      base_link="$(arg base_link)"
      flange_link="$(arg flange_link)"
      prefix="$(arg prefix)">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:mycobot_320_arm>

    <xacro:if value="$(arg use_gripper)">
        <xacro:property name="current_gripper" value="$(arg gripper_type)"/>
        <xacro:if value="${current_gripper == 'adaptive_gripper'}">
            <xacro:include filename="$(find mycobot_description)/urdf/mech/adaptive_gripper.urdf.xacro"/>
            <xacro:adaptive_gripper
                parent="$(arg flange_link)"
                prefix="$(arg prefix)">
                <origin xyz="0 0 0.034" rpy="1.579 0 0"/>
            </xacro:adaptive_gripper>
        </xacro:if>
    </xacro:if>

    <xacro:include filename="$(find mycobot_description)/urdf/control/gazebo_sim_ros2_control.urdf.xacro" />
    <xacro:load_gazebo_sim_ros2_control_plugin
      robot_name="$(arg robot_name)"
      use_gazebo="$(arg use_gazebo)"/>

    <xacro:include filename="$(find mycobot_description)/urdf/control/mycobot_280_ros2_control.urdf.xacro" />
    <xacro:mycobot_ros2_control
      prefix="$(arg prefix)"
      flange_link="$(arg flange_link)"
      use_gazebo="$(arg use_gazebo)"/>

    <xacro:include filename="$(find mycobot_description)/urdf/sensors/intel_rgbd_cam_d435.urdf.xacro"/>
    <!-- === Cinco links fijos de demostración === -->

    <!-- Link 1, anclado al flange -->
    <link name="fixed_link_1"/>
    <joint name="fixed_joint_1" type="fixed">
      <parent link="world"/>
      <child  link="fixed_link_1"/>
      <!-- sube 0.15 m y gira 15° en yaw -->
      <origin xyz="0.5 0.5 0.15" rpy="0 0 0.2618"/>
    </joint>

    <!-- Link 2 -->
    <link name="fixed_link_2"/>
    <joint name="fixed_joint_2" type="fixed">
      <parent link="fixed_link_1"/>
      <child  link="fixed_link_2"/>
      <!-- sube otros 0.15 m y gira 30° en yaw -->
      <origin xyz="0.5 0.5 0.15" rpy="0 0 0.5236"/>
    </joint>

    <!-- Link 3 -->
    <link name="fixed_link_3"/>
    <joint name="fixed_joint_3" type="fixed">
      <parent link="fixed_link_2"/>
      <child  link="fixed_link_3"/>
      <!-- sube 0.15 m y gira 45° en yaw -->
      <origin xyz="0.5 0.5 0.15" rpy="0 0 0.7854"/>
    </joint>

    <!-- Link 4 -->
    <link name="fixed_link_4"/>
    <joint name="fixed_joint_4" type="fixed">
      <parent link="fixed_link_3"/>
      <child  link="fixed_link_4"/>
      <!-- sube 0.15 m y gira 60° en yaw -->
      <origin xyz="0.5 0.5 0.15" rpy="0 0 1.0472"/>
    </joint>

    <!-- Link 5 -->
    <link name="fixed_link_5"/>
    <joint name="fixed_joint_5" type="fixed">
      <parent link="fixed_link_4"/>
      <child  link="fixed_link_5"/>
      <!-- sube 0.15 m y gira –30° en yaw -->
      <origin xyz="0.5 0.5 0.15" rpy="0 0 -0.5236"/>
    </joint>

    <!-- === Fin cinco links fijos === -->
</robot>
